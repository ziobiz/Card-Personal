# Backend
PORT=3001
JWT_SECRET=change-in-production

# Admin (기본: admin@wirexcard.local / admin123)
ADMIN_EMAIL=admin@wirexcard.local
ADMIN_PASSWORD=admin123

# Wirex BaaS (docs.wirexapp.com)
