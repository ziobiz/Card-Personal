# Backend
# 로컬: 127.0.0.1 / 카페24 VPS: 0.0.0.0
HOST=127.0.0.1
PORT=3001
JWT_SECRET=change-in-production

# Admin (기본: admin@icocard.local / admin123)
ADMIN_EMAIL=admin@icocard.local
ADMIN_PASSWORD=admin123

# Wirex BaaS (https://docs.wirexapp.com/docs/environments)
# 미설정 시 Sandbox 공개 자격증명 사용 (2026-04 문서)
# sandbox | production
WIREX_ENV=sandbox
WIREX_BAAS_URL=https://api-baas.wirexapp.tech
WIREX_HELPER_URL=https://ramc.wirexapp.tech
WIREX_PCI_URL=https://wx-acquiring-card-manager-uat.wirexapp.com
WIREX_CHAIN_ID=84532
WIREX_CLIENT_ID=
WIREX_CLIENT_SECRET=
WIREX_PARTNER_ID=
# Base Sepolia Unified Balance
WIREX_WUSD_TOKEN=0x0774164DC20524Bb239b39D1DC42573C3E4C6976
WIREX_WEBHOOK_SECRET=
TRAVEL_RULE_THRESHOLD_USD=1000
PARTNER_RATE_LIMIT_PER_MIN=300

# Live 통합 테스트 스크립트 (backend: npm run test:flow)
# USE_MOCK_WIREX=false
# WALLET_ADDRESS=0x...   # ZeroDev/Accounts 에 등록된 EOA
# TEST_EMAIL=you@example.com
# TEST_COUNTRY=GB

# Wirex 모드: true=Mock(기본), false=실제 Sandbox/Production API
USE_MOCK_WIREX=true
