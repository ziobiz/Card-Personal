WIREX_BAAS_URL=https://api-baas.wirexapp.tech
WIREX_CHAIN_ID=84532
WIREX_CLIENT_ID=
WIREX_CLIENT_SECRET=

# Wirex 모드: true=Mock(기본), false=실제 API
USE_MOCK_WIREX=true
