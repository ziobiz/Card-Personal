# White-label / sold-operator package env template
# Copy to backend/.env for a buyer deployment. Do NOT commit real secrets.

HOST=0.0.0.0
PORT=3001
JWT_SECRET=CHANGE_ME_LONG_RANDOM

ADMIN_EMAIL=admin@buyer-domain.com
ADMIN_PASSWORD=CHANGE_ME_AFTER_HANDOVER

# Keep mock=true until Wirex issues dedicated Sandbox keys for THIS deployment
USE_MOCK_WIREX=true
WIREX_ENV=sandbox
WIREX_BAAS_URL=https://api-baas.wirexapp.tech
WIREX_HELPER_URL=https://ramc.wirexapp.tech
WIREX_PCI_URL=https://wx-acquiring-card-manager-uat.wirexapp.com
WIREX_CHAIN_ID=84532

# Fill after Wirex Sandbox key issuance (per buyer / per deploy)
WIREX_CLIENT_ID=
WIREX_CLIENT_SECRET=
WIREX_PARTNER_ID=
WIREX_WEBHOOK_SECRET=

# WebAuthn (buyer member domain)
WEBAUTHN_RP_ID=buyer-domain.com
WEBAUTHN_RP_NAME=BUYER_BRAND
WEBAUTHN_ORIGIN=https://app.buyer-domain.com

# Per-tenant AES key for embedded EOA (do not reuse across buyers)
WALLET_ENC_KEY=CHANGE_ME_WALLET_ENC

OTP_REQUIRED_MEMBER=true
OTP_REQUIRED_ADMIN=true
OTP_REQUIRED_ORG=true

# Optional ops
TRAVEL_RULE_THRESHOLD_USD=1000
PARTNER_RATE_LIMIT_PER_MIN=300
